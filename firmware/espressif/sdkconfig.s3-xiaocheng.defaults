# Xiaocheng ESP32-S3 handheld board profile (ESP32-S3 N16R8, 8 MiB octal PSRAM).
CONFIG_MICROPIXEL_BOARD_XIAOCHENG_ESP32S3=y

# The ST7789 accepts direct PSRAM SPI DMA; 40-row partial buffers keep SPI DMA
# sources in internal SRAM while leaving PSRAM for Guest linear memory.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
# CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM is not set

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
